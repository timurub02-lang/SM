  "narrative": {
    "northStar": "Existing CRM operator workspace",
    "overview": "An extension of the existing SM CRM operator workspace: teal actions, white bordered surfaces and a pale neutral ground. This scoped record describes the finished local simulation in index.html, style.css and app.mjs; it does not establish a new identity for the parent CRM or imply a live Skorozvon connection.",
    "keyCharacteristics": [
      "Restrained, flat surfaces with visible boundaries.",
      "Compact readable controls and explicit call states.",
      "Customer context beside the call on desktop, below it on narrow screens."
    ],
    "rules": [
      {
        "name": "Action and State",
        "body": "Use teal for primary actions and pale teal for selected context and call status; reserve red for ending a call and errors.",
        "section": "colors"
      },
      {
        "name": "Flat Surfaces",
        "body": "Separate panels with borders and background tones; the implemented surfaces have no shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the inherited CRM palette and body typography.",
      "Do pair state colors with text and preserve visible keyboard focus.",
      "Do keep synthetic-mode and tab-memory limitations visible."
    ],
    "donts": [
      "Don't describe simulated actions as successful provider operations.",
      "Don't replace the selected customer while a call or its result is active."
    ]
  }
