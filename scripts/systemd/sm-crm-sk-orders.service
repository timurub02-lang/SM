[Unit]
Description=SM CRM orders from Skorozvon
After=network-online.target

[Service]
Type=oneshot
User=crmadmin
Group=crmadmin
WorkingDirectory=/srv/crm/current
EnvironmentFile=/etc/sm-crm.env
ExecStart=/opt/sm-node/bin/node --experimental-strip-types scripts/sync-sk-orders.mjs
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sm-crm
